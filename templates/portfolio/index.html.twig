<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Portfolio – {{ profil ? profil.prenom ~ ' ' ~ profil.nom : 'Daniel Bokingo' }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{ asset('portfolio/style.css?v=database-content-1') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    {% include 'portfolio/header.html.twig' %}

    <main>
        {% if profil and (profil.aboutMe or profil.objectif) %}
            <section id="about" class="section section-light">
                <div class="container hidden">
                    <h2 class="section-title">À propos de moi</h2>
                    <div class="grid-2">
                        {% if profil.aboutMe %}
                            <div>{{ profil.aboutMe|nl2br }}</div>
                        {% endif %}
                        {% if profil.objectif %}
                            <div class="about-highlight">
                                <h3>Mon objectif</h3>
                                <p>{{ profil.objectif|nl2br }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}

        <!-- Compétences -->
        <section id="skills" class="section section-light">
            <div class="container hidden">
                <h2 class="section-title section-title-center">Compétences</h2>
                <div class="skill-filter-nav" aria-label="Filtrer les compétences"></div>
                <div class="skills-grid-new">
                    {% for competence in competences %}
                        <div class="skill-item">
                            <i class="{{ competence.logo }}" aria-hidden="true"></i>
                            <span>{{ competence.nom }}</span>
                        </div>
                    {% else %}
                        <p>Aucune compétence n’est renseignée pour le moment.</p>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section id="projects" class="section section-dark">
            <div class="container hidden">
                <h2 class="section-title section-title-center">Projets</h2>
                <div class="project-nav" aria-label="Filtrer les projets">
                    <!-- Les boutons de filtre sont maintenant gérés en JS, pas besoin de les modifier ici -->
                </div>

                <div class="projects-grid">
                    {% for projet in projets %}
                        {% set mediaUrls = [] %}
                        {% for media in projet.medias %}
                            {% set mediaUrls = mediaUrls|merge([{
                                url: path('app_projet_media', {id: media.id}),
                                type: media.typeMime
                            }]) %}
                        {% endfor %}
                        {% set premiereMedia = projet.medias|first %}
                        <article class="project-card" data-category="{{ projet.categorie }}"
                            data-title="{{ projet.titre }}"
                            data-description="{{ projet.description }}{% if projet.technologies %}&#10;&#10;Technologies : {{ projet.technologies }}{% endif %}"
                            data-media="{{ mediaUrls|json_encode|e('html_attr') }}">
                            {% if premiereMedia %}
                                {% if premiereMedia.video %}
                                    <video class="project-image" muted playsinline preload="metadata" aria-label="Aperçu de {{ projet.titre }}">
                                        <source src="{{ path('app_projet_media', {id: premiereMedia.id}) }}" type="{{ premiereMedia.typeMime }}">
                                    </video>
                                {% else %}
                                    <img src="{{ path('app_projet_media', {id: premiereMedia.id}) }}" alt="{{ projet.titre }}" class="project-image">
                                {% endif %}
                            {% else %}
                                <div class="project-image project-placeholder" aria-hidden="true"><i class="fa-solid fa-images"></i></div>
                            {% endif %}
                            <div class="project-overlay">
                                <h3>{{ projet.titre }}</h3>
                                <button class="btn ghost open-modal-btn" type="button">Voir le projet</button>
                                {% if projet.lien %}
                                    <a class="btn ghost" href="{{ projet.lien }}" target="_blank" rel="noopener noreferrer">Lien externe</a>
                                {% endif %}
                            </div>
                        </article>
                    {% else %}
                        <p class="projects-empty">Les projets seront bientôt disponibles.</p>
                    {% endfor %}
                </div>
            </div>
            <br><br>

        <!-- Parcours & expériences -->
        <section id="experience" class="section section-light">
            <div class="container hidden">
                <h2 class="section-title">Parcours & expériences</h2>
                <div class="timeline">
                    {% for p in parcours %}
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <h3>{{ p.titre }}</h3>
                                <p class="timeline-sub">
                                    {{ p.debut|date('m/Y') }} – {{ p.fin|date('m/Y') }}
                                    · <strong>{{ p.entite }}</strong> · {{ p.localisation }}
                                </p>
                                {% if stacksById[p.idStack] is defined %}
                                    <ul class="pill-list">
                                        <li>{{ stacksById[p.idStack].nom }}</li>
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p>Le parcours sera bientôt renseigné.</p>
                    {% endfor %}
                </div>
            </div>
        </section>



        <!-- Contact -->
        <section id="contact" class="section section-contact">
            <div class="container hidden">
                <h2 class="section-title section-title-center">Contact</h2>
                <p class="contact-intro">
                    <i class="fa-solid fa-handshake" aria-hidden="true"></i>
                    Je suis disponible pour un stage, une alternance ou une collaboration sur un projet.
                    Écrivez-moi pour en discuter.
                </p>
                <div class="contact-grid">
                    <form class="contact-form" onsubmit="return false;">
                        <div class="contact-info">
                                                    <p><i class="fa-solid fa-location-dot"></i><strong>Je suis basé à :</strong> Valenciennes, France</p>
                                                        <p><i class="fa-solid fa-envelope"></i><strong>Mon email :</strong> <a href="mailto:bokingodaniel4@gmail.com">bokingodaniel4@gmail.com</a></p>
                                                        <p><i class="fa-brands fa-linkedin"></i><strong>Mon profil LinkedIn :</strong> <a href="https://www.linkedin.com/in/daniel-bokingo-024415357/" target="_blank" rel="noopener noreferrer">
                                danielbokingo.LinkedIn</a></p>
                            <p><i class="fa-brands fa-github"></i><strong>Mon GitHub :</strong> <a href="https://github.com/BonkingoDaniel006" target="_blank" rel="noopener noreferrer">
                                github.com/BonkingoDaniel006</a></p>
                            <p><i class="fa-solid fa-phone"></i><strong>Mon téléphone :</strong> <a href="tel:+33759451864">+33 7 59 45 18 64</a></p>
                        </div>
                        
                        
                    
                    </form>
                </div>
                
            </div>
        </section>
    </main>

    {% include 'portfolio/footer.html.twig' %}
    {% include 'portfolio/modal.html.twig' %}

    <script src="{{ asset('portfolio/script.js?v=project-crud-1') }}"></script>
</body>
</html>
