{% extends 'base_admin.html.twig' %}

{% block body %}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
    {% endblock %}
    <div class="dashboard-shell">
        <aside class="sidebar">
            <a href="#" class="brand-logo">
                <i class="fa-solid fa-angles-right"></i> Bokingofolio
            </a>

            <div class="sidebar-section-label">Navigation</div>
            <nav class="sidebar-nav">
                <button class="tab-btn active" onclick="switchTab('projects', this)"><i class="fa-solid fa-table-columns"></i> Tableau</button>
                <button class="tab-btn" onclick="switchTab('messages', this)"><i class="fa-solid fa-envelope"></i> Messages</button>
                <button class="tab-btn" onclick="switchTab('skills', this)"><i class="fa-solid fa-code"></i> Compétences</button>
                <button class="tab-btn" onclick="switchTab('profile', this)"><i class="fa-solid fa-user"></i> Profil</button>
                <a class="tab-btn" href="{{ path('app_logout') }}"><i class="fa-solid fa-right-from-bracket"></i> Déconnexion</a>
            </nav>

            <div class="sidebar-section-label">Système</div>
            <nav class="sidebar-nav">
                <button class="tab-btn" onclick="showToast('Documentation ouverte')"><i class="fa-solid fa-book"></i> Docs API</button>
                <button class="tab-btn" onclick="showToast('Logs du serveur')"><i class="fa-solid fa-terminal"></i> Logs</button>
            </nav>

            <div class="sidebar-mini-card">
                <div class="mini-label">Performance</div>
                <div class="mini-stat">
                    <span>Disponibilité</span>
                    <span>72%</span>
                </div>
                <div class="mini-bar"><span></span></div>
            </div>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-kicker">Dashboard / Portfolio Admin</div>

                <div class="topbar-actions">
                    <div class="search-bar">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Rechercher un projet, un message, une compétence...">
                    </div>

                    <div class="nav-actions">
                        <a href="https://bokingofolio.onrender.com" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Voir le site</a>
                        <a href="#">Support</a>
                        <div class="user-avatar-btn" onclick="handleLogout()" title="Déconnexion">D</div>
                    </div>
                </div>
            </header>

            <main class="main-content">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="dashboard-flash dashboard-flash-{{ label }}" role="status">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <div class="hero-row">
                    <div class="hero-block">
                        <div class="hero-badge"><i class="fa-solid fa-sparkles"></i></div>
                        <div>
                            <strong>Bonjour Daniel</strong>
                            <span>Dernière mise à jour il y a 2h</span>
                        </div>
                    </div>

                    <a class="btn btn-black" style="width: auto; padding: 12px 18px;" href="{{ path('app_projet_new') }}">
                        <i class="fa-solid fa-plus"></i> Ajouter un projet
                    </a>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon"><i class="fa-solid fa-diagram-project"></i></div>
                            <div class="stat-pill">+12%</div>
                        </div>
                        <div class="value">{{ projets|length }}</div>
                        <div class="label">Projets actifs</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon"><i class="fa-solid fa-envelope-open-text"></i></div>
                            <div class="stat-pill">+4</div>
                        </div>
                        <div class="value">24</div>
                        <div class="label">Messages reçus</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon"><i class="fa-solid fa-code"></i></div>
                            <div class="stat-pill">Stable</div>
                        </div>
                        <div class="value">12</div>
                        <div class="label">Technologies gérées</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon"><i class="fa-solid fa-bolt"></i></div>
                            <div class="stat-pill">Live</div>
                        </div>
                        <div class="value">99.9%</div>
                        <div class="label">Disponibilité</div>
                    </div>
                </div>

                <section id="projects" class="section-pane active">
                    <div class="page-header">
                        <h1>Gestion des Projets</h1>
                        <p>Ajoutez, modifiez et supprimez les projets publiés dans votre portfolio.</p>
                    </div>

                    <div class="list-grid">
                        <div>
                            {% for projet in projets %}
                                {% set premiereMedia = projet.medias|first %}
                                <article class="card-item">
                                    <div class="card-media">
                                        {% if premiereMedia %}
                                            {% if premiereMedia.video %}
                                                <i class="fa-solid fa-film" aria-label="Vidéo"></i>
                                            {% else %}
                                                <img src="{{ path('app_projet_media', {id: premiereMedia.id}) }}" alt="" style="width: 100%; height: 100%; object-fit: cover; border-radius: inherit;">
                                            {% endif %}
                                        {% else %}
                                            <i class="fa-solid fa-images"></i>
                                        {% endif %}
                                    </div>
                                    <div class="card-body">
                                        <div class="card-ref">Projet n° {{ projet.id }} · {{ projet.categorie|upper }}</div>
                                        <h2 class="card-title">{{ projet.titre }}</h2>
                                        <p>{{ projet.description|slice(0, 180) }}{% if projet.description|length > 180 %}…{% endif %}</p>
                                        {% if projet.technologies %}
                                            <p><strong>Technologies :</strong> {{ projet.technologies }}</p>
                                        {% endif %}
                                        <p>{{ projet.medias|length }} média(s)</p>
                                    </div>
                                    <div class="card-actions">
                                        <a class="btn btn-black" href="{{ path('app_projet_edit', {id: projet.id}) }}">Modifier</a>
                                        {% if projet.lien %}
                                            <a class="btn btn-outline" href="{{ projet.lien }}" target="_blank" rel="noopener noreferrer">Voir le projet</a>
                                        {% endif %}
                                        <button class="btn btn-danger" type="button" onclick="openProjectDeleteConfirm({{ projet.id }})">Supprimer</button>
                                    </div>
                                </article>
                                <div id="project-delete-confirm-{{ projet.id }}" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="project-delete-confirm-title-{{ projet.id }}" hidden>
                                    <div class="dashboard-modal-content dashboard-result-modal">
                                        <div class="dashboard-result-icon is-warning" aria-hidden="true">!</div>
                                        <h2 id="project-delete-confirm-title-{{ projet.id }}">Supprimer ce projet ?</h2>
                                        <p class="dashboard-modal-intro">« {{ projet.titre }} » et ses médias seront supprimés définitivement. Voulez-vous continuer ?</p>
                                        <div class="dashboard-modal-actions">
                                            <button class="btn btn-gray" type="button" onclick="closeProjectDeleteConfirm({{ projet.id }})">Annuler</button>
                                            <button class="btn btn-danger" type="button" onclick="openProjectDeletePassword({{ projet.id }})">Continuer</button>
                                        </div>
                                    </div>
                                </div>
                                <div id="project-delete-password-{{ projet.id }}" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="project-delete-password-title-{{ projet.id }}" hidden>
                                    <div class="dashboard-modal-content">
                                        <h2 id="project-delete-password-title-{{ projet.id }}">Confirmez votre identité</h2>
                                        <p class="dashboard-modal-intro">Saisissez votre mot de passe pour supprimer « {{ projet.titre }} ».</p>
                                        <form action="{{ path('app_projet_delete', {id: projet.id}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_project_' ~ projet.id) }}">
                                            <div class="form-group">
                                                <label for="project-delete-password-input-{{ projet.id }}">Mot de passe</label>
                                                <input id="project-delete-password-input-{{ projet.id }}" class="form-control" type="password" name="password" autocomplete="current-password" required>
                                            </div>
                                            <div class="dashboard-modal-actions">
                                                <button class="btn btn-gray" type="button" onclick="closeProjectDeletePassword({{ projet.id }})">Annuler</button>
                                                <button class="btn btn-danger" type="submit">Confirmer la suppression</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            {% else %}
                                <div class="form-card">
                                    <p>Aucun projet n’est enregistré. Ajoutez votre premier projet pour le publier sur la vitrine.</p>
                                </div>
                            {% endfor %}
                        </div>

                        <div>
                            <div class="mini-panel">
                                <h3>Activité récente</h3>
                                <div class="activity-list">
                                    <div class="activity-item">
                                        <div class="activity-flag"><i class="fa-solid fa-arrow-up-right-dots"></i></div>
                                        <div class="activity-copy">
                                            <strong>Déploiement Elikya</strong>
                                            <span>il y a 2 heures</span>
                                        </div>
                                    </div>
                                    <div class="activity-item">
                                        <div class="activity-flag"><i class="fa-solid fa-message"></i></div>
                                        <div class="activity-copy">
                                            <strong>3 nouveaux messages</strong>
                                            <span>aujourd’hui</span>
                                        </div>
                                    </div>
                                    <div class="activity-item">
                                        <div class="activity-flag"><i class="fa-solid fa-diagram-project"></i></div>
                                        <div class="activity-copy">
                                            <strong>Nouveau projet ajouté</strong>
                                            <span>hier</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mini-panel">
                                <h3>Vue rapide</h3>
                                <div class="activity-list">
                                    <div class="activity-item">
                                        <div class="activity-flag"><i class="fa-solid fa-rocket"></i></div>
                                        <div class="activity-copy">
                                            <strong>Livrables</strong>
                                            <span>6 prêts pour publication</span>
                                        </div>
                                    </div>
                                    <div class="activity-item">
                                        <div class="activity-flag"><i class="fa-solid fa-clock"></i></div>
                                        <div class="activity-copy">
                                            <strong>Temps moyen</strong>
                                            <span>3 jours par projet</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="messages" class="section-pane">
                    <div class="page-header">
                        <h1>Messages & Contact</h1>
                        <p>Consultez les prises de contact reçues via le formulaire de votre portfolio.</p>
                    </div>

                    <div class="card-item">
                        <div class="card-media" style="font-size: 1.7rem;">
                            <i class="fa-solid fa-envelope-open-text"></i>
                        </div>
                        <div class="card-body">
                            <div class="card-ref">Reçu le 30/08/2026 — De: Recrutement Tech</div>
                            <div class="card-title">Proposition de mission / Alternance Master</div>
                            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">
                                "Bonjour Daniel, nous avons examiné vos projets Full-Stack et IoT. Nous souhaiterions échanger avec vous concernant..."
                            </p>
                        </div>
                        <div class="card-actions">
                            <button class="btn btn-black" onclick="showToast('Réponse envoyée par mail')">Répondre</button>
                            <button class="btn btn-outline" onclick="showToast('Message archivé')">Archiver</button>
                        </div>
                    </div>
                </section>

                <section id="skills" class="section-pane">
                    <div class="page-header">
                        <h1>Compétences Techniques</h1>
                        <p>Gérez vos langages, frameworks et outils affichés sur la page d'accueil.</p>
                    </div>

                    <div class="form-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 16px;">
                            <h3 style="font-weight: 800;">Liste des competences</h3>
                            {% if competenceForm %}
                                <button type="button" class="btn btn-black" style="width: auto;" onclick="openCompetenceModal()"><i class="fa-solid fa-plus"></i> Ajouter une compétence</button>
                            {% endif %}
                        </div>
                        <div class="form-group">
                           {% for competence in competences %}
                                <div class="skill-item" data-competence-id="{{ competence.id }}">
                                    <i class="{{ competence.logo }}"></i>
                                    <span>{{ competence.nom }}</span>
                                    <div class="skill-actions">
                                        <button type="button" class="skill-menu-toggle" aria-label="Actions pour {{ competence.nom }}" aria-expanded="false" onclick="toggleCompetenceMenu(event, {{ competence.id }})">
                                            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                        </button>
                                        <div id="competence-menu-{{ competence.id }}" class="skill-actions-menu" hidden>
                                            <button type="button" onclick="openCompetenceEditModal({{ competence.id }})"><i class="fa-solid fa-pen" aria-hidden="true"></i> Modifier</button>
                                            <button type="button" class="is-danger" onclick="openCompetenceDeleteModal({{ competence.id }})"><i class="fa-solid fa-trash" aria-hidden="true"></i> Supprimer</button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                    </div>
                </section>

                <section id="profile" class="section-pane">
                    <div class="page-header">
                        <h1>Profil & Portfolio</h1>
                        <p>Mettez à jour vos informations personnelles et statuts d'activité.</p>
                    </div>

                    <div class="form-card">
                        {% if profileForm %}
                            {{ form_start(profileForm, {attr: {class: 'profile-form'}}) }}
                                <div class="form-group">
                                    {{ form_row(profileForm.prenom, {label: 'Prénom', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.nom, {label: 'Nom', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.titre, {label: 'Titre', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.bio, {label: 'Biographie', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.about_me, {label: 'À propos', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.objectif, {label: 'Objectif', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.photo, {label: 'Photo', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.cv, {label: 'CV', attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="form-group">
                                    {{ form_row(profileForm.disponibilite, {label: 'Disponibilité', attr: {class: 'form-control'}}) }}
                                </div>
                                <button type="submit" class="btn btn-black" style="width: auto;">Enregistrer les modifications</button>
                            {{ form_end(profileForm) }}
                        {% else %}
                            <p>Aucun profil n’est encore enregistré.</p>
                        {% endif %}
                    </div>
                </section>
            </main>
        </div>
    </div>

    {% if competenceForm %}
        <div id="competence-modal" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="competence-modal-title" hidden>
            <div class="dashboard-modal-content">
                <button type="button" class="dashboard-modal-close" onclick="closeCompetenceModal()" aria-label="Fermer">&times;</button>
                <h2 id="competence-modal-title">Ajouter une compétence</h2>
                <p class="dashboard-modal-intro">Ajoutez une technologie à votre portfolio.</p>
                {{ form_start(competenceForm, {attr: {id: 'competence-form'}}) }}
                    {{ form_row(competenceForm.nom, {label: 'Nom', attr: {class: 'form-control', required: true}}) }}
                    {{ form_row(competenceForm.logo, {label: 'Classe de l’icône', attr: {class: 'form-control', placeholder: 'devicon-php-plain'}}) }}
                    {{ form_widget(competenceForm.id_profil) }}
                    <div class="dashboard-modal-actions">
                        <button type="button" class="btn btn-gray" onclick="closeCompetenceModal()">Annuler</button>
                        <button type="submit" class="btn btn-black">Enregistrer</button>
                    </div>
                {{ form_end(competenceForm) }}
            </div>
        </div>
    {% endif %}

    {% for competence in competences %}
        {% set editForm = competenceForms[competence.id] %}
        <div id="competence-edit-modal-{{ competence.id }}" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="competence-edit-title-{{ competence.id }}" hidden>
            <div class="dashboard-modal-content">
                <button type="button" class="dashboard-modal-close" onclick="closeCompetenceEditModal({{ competence.id }})" aria-label="Fermer">&times;</button>
                <h2 id="competence-edit-title-{{ competence.id }}">Modifier la compétence</h2>
                <p class="dashboard-modal-intro">Mettez à jour les informations de cette compétence.</p>
                {{ form_start(editForm, {attr: {class: 'competence-edit-form', 'data-competence-id': competence.id}}) }}
                    {{ form_row(editForm.nom, {label: 'Nom', attr: {class: 'form-control', required: true}}) }}
                    {{ form_row(editForm.logo, {label: 'Classe de l’icône', attr: {class: 'form-control'}}) }}
                    {{ form_widget(editForm.id_profil) }}
                    <div class="dashboard-modal-actions">
                        <button type="button" class="btn btn-gray" onclick="closeCompetenceEditModal({{ competence.id }})">Annuler</button>
                        <button type="submit" class="btn btn-black">Enregistrer</button>
                    </div>
                {{ form_end(editForm) }}
            </div>
        </div>

        <div id="competence-delete-modal-{{ competence.id }}" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="competence-delete-title-{{ competence.id }}" hidden>
            <div class="dashboard-modal-content dashboard-result-modal">
                <div class="dashboard-result-icon is-warning" aria-hidden="true">!</div>
                <h2 id="competence-delete-title-{{ competence.id }}">Supprimer la compétence ?</h2>
                <p class="dashboard-modal-intro">Cette action supprimera « {{ competence.nom }} » définitivement.</p>
                <form class="competence-delete-form" action="{{ path('app_competences_delete', {id: competence.id}) }}" method="post" data-competence-id="{{ competence.id }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competence.id) }}">
                    <div class="dashboard-modal-actions">
                        <button type="button" class="btn btn-gray" onclick="closeCompetenceDeleteModal({{ competence.id }})">Annuler</button>
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}

    <div id="competence-result-modal" class="dashboard-modal" role="dialog" aria-modal="true" aria-labelledby="competence-result-title" hidden>
        <div class="dashboard-modal-content dashboard-result-modal">
            <div id="competence-result-icon" class="dashboard-result-icon" aria-hidden="true"></div>
            <h2 id="competence-result-title">Résultat</h2>
            <p id="competence-result-message"></p>
            <button type="button" class="btn btn-black" onclick="closeCompetenceResult()">Fermer</button>
        </div>
    </div>

    <div id="toast" class="toast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toast-text">Action effectuée</span>
    </div>

    <!-- JAVASCRIPT SIMPLE (VANILLA) -->
    <script>
        function switchTab(tabId, btnElement) {
            // Désactiver tous les onglets
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.section-pane').forEach(pane => pane.classList.remove('active'));

            // Activer le bon onglet
            btnElement.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function openProjectDeleteConfirm(id) {
            document.getElementById(`project-delete-confirm-${id}`).hidden = false;
        }

        function closeProjectDeleteConfirm(id) {
            document.getElementById(`project-delete-confirm-${id}`).hidden = true;
        }

        function openProjectDeletePassword(id) {
            closeProjectDeleteConfirm(id);
            const modal = document.getElementById(`project-delete-password-${id}`);
            modal.hidden = false;
            modal.querySelector('input[type="password"]').focus();
        }

        function closeProjectDeletePassword(id) {
            const modal = document.getElementById(`project-delete-password-${id}`);
            modal.hidden = true;
            modal.querySelector('input[type="password"]').value = '';
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-text').textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        function openCompetenceModal() {
            const modal = document.getElementById('competence-modal');
            if (modal) {
                modal.hidden = false;
                modal.querySelector('input[name$="[nom]"]')?.focus();
            }
        }

        function closeCompetenceModal() {
            const modal = document.getElementById('competence-modal');
            if (modal) {
                modal.hidden = true;
            }
        }

        function toggleCompetenceMenu(event, id) {
            event.stopPropagation();
            const menu = document.getElementById(`competence-menu-${id}`);
            const button = event.currentTarget;
            document.querySelectorAll('.skill-actions-menu').forEach(item => {
                if (item !== menu) item.hidden = true;
            });
            document.querySelectorAll('.skill-menu-toggle').forEach(item => item.setAttribute('aria-expanded', 'false'));
            menu.hidden = !menu.hidden;
            button.setAttribute('aria-expanded', String(!menu.hidden));
        }

        document.addEventListener('click', () => {
            document.querySelectorAll('.skill-actions-menu').forEach(menu => menu.hidden = true);
            document.querySelectorAll('.skill-menu-toggle').forEach(button => button.setAttribute('aria-expanded', 'false'));
        });

        function openCompetenceEditModal(id) {
            document.getElementById(`competence-menu-${id}`).hidden = true;
            document.getElementById(`competence-edit-modal-${id}`).hidden = false;
        }

        function closeCompetenceEditModal(id) {
            document.getElementById(`competence-edit-modal-${id}`).hidden = true;
        }

        function openCompetenceDeleteModal(id) {
            document.getElementById(`competence-menu-${id}`).hidden = true;
            document.getElementById(`competence-delete-modal-${id}`).hidden = false;
        }

        function closeCompetenceDeleteModal(id) {
            document.getElementById(`competence-delete-modal-${id}`).hidden = true;
        }

        function openCompetenceResult(success, message) {
            const modal = document.getElementById('competence-result-modal');
            const icon = document.getElementById('competence-result-icon');
            document.getElementById('competence-result-title').textContent = success ? 'Compétence ajoutée' : 'Échec de l’ajout';
            document.getElementById('competence-result-message').textContent = message;
            icon.textContent = success ? '✓' : '!';
            icon.className = `dashboard-result-icon ${success ? 'is-success' : 'is-error'}`;
            modal.hidden = false;
        }

        function closeCompetenceResult() {
            document.getElementById('competence-result-modal').hidden = true;
            if (document.getElementById('competence-result-icon').classList.contains('is-success')) {
                window.location.reload();
            }
        }

        document.getElementById('competence-form')?.addEventListener('submit', async function(event) {
            await submitCompetenceForm(event, closeCompetenceModal);
        });

        document.querySelectorAll('.competence-edit-form').forEach(form => {
            form.addEventListener('submit', event => submitCompetenceForm(event, () => closeCompetenceEditModal(form.dataset.competenceId)));
        });

        document.querySelectorAll('.competence-delete-form').forEach(form => {
            form.addEventListener('submit', event => submitCompetenceForm(event, () => closeCompetenceDeleteModal(form.dataset.competenceId)));
        });

        async function submitCompetenceForm(event, closeModal) {
            event.preventDefault();
            const form = event.currentTarget;
            const submitButton = form.querySelector('button[type="submit"]');
            submitButton.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                });
                const result = await response.json();
                closeModal();
                openCompetenceResult(response.ok && result.success, result.message);
            } catch (error) {
                closeModal();
                openCompetenceResult(false, 'Une erreur réseau est survenue.');
            } finally {
                submitButton.disabled = false;
            }
        }

        function handleLogout() {
            if(confirm("Se déconnecter de la session d'administration ?")) {
                showToast("Déconnexion en cours...");
                setTimeout(() => location.reload(), 1000);
            }
        }

    </script>

{% endblock %}
